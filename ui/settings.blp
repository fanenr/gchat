using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog settings_dialog {
  title: _("Settings");
  search-enabled: false;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: "API";

      Adw.PasswordEntryRow key_row {
        title: _("API key");
        show-apply-button: true;
      }

      Adw.ActionRow key_source {
        title: _("Key source");
        use-markup: false;
      }
    }

    Adw.PreferencesGroup {
      title: _("Conversation");

      Adw.SwitchRow auto_title {
        title: _("Automatic conversation titles");
      }

      Adw.SwitchRow confirm_delete_chat {
        title: _("Confirm conversation deletion");
      }
    }

    Adw.PreferencesGroup {
      title: _("Appearance");

      Adw.ComboRow theme {
        title: _("Theme");
      }

      Adw.ComboRow language {
        title: _("Language");
        subtitle: _("Restart the app to apply language changes.");
      }
    }

    Adw.PreferencesGroup {
      title: _("Reading");

      Adw.ActionRow {
        title: _("Message font");
        activatable-widget: message_font;

        [suffix]
        Gtk.FontDialogButton message_font {
          valign: center;
          level: family;
          dialog: Gtk.FontDialog {
            title: _("Message font");
          };
        }

        [suffix]
        Gtk.Button message_font_reset {
          visible: false;
          valign: center;
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Use default font");
          styles [ "flat" ]
        }
      }

      Adw.SpinRow message_font_size {
        title: _("Message font size");
        digits: 1;
        adjustment: Gtk.Adjustment {
          lower: 6;
          upper: 72;
          step-increment: 0.5;
          page-increment: 2;
        };

        [suffix]
        Gtk.Button message_font_size_reset {
          visible: false;
          valign: center;
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Use default font size");
          styles [ "flat" ]
        }
      }

      Adw.ActionRow {
        title: _("Code block font");
        activatable-widget: code_font;

        [suffix]
        Gtk.FontDialogButton code_font {
          valign: center;
          level: family;
          dialog: Gtk.FontDialog {
            title: _("Code block font");
          };
        }

        [suffix]
        Gtk.Button code_font_reset {
          visible: false;
          valign: center;
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Use default font");
          styles [ "flat" ]
        }
      }

      Adw.SpinRow code_font_size {
        title: _("Code block font size");
        digits: 1;
        adjustment: Gtk.Adjustment {
          lower: 6;
          upper: 72;
          step-increment: 0.5;
          page-increment: 2;
        };

        [suffix]
        Gtk.Button code_font_size_reset {
          visible: false;
          valign: center;
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Use default font size");
          styles [ "flat" ]
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("About");

      Adw.ActionRow version {
        title: "gchat";
        use-markup: false;
      }

      Adw.ActionRow session_path {
        title: _("Conversation data");
        use-markup: false;
      }
    }
  }
}
